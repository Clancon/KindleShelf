# Copy to .env for Docker Compose and set the server's LAN address.
KINDLE_SHELF_PUBLIC_URL=
KINDLE_SHELF_HOST_PORT=8090
KINDLE_SHELF_BIND_IP=0.0.0.0
TZ=Asia/Shanghai
KINDLE_SHELF_TIMEZONE=Asia/Shanghai
KINDLE_SHELF_MEMORY_LIMIT=2g
KINDLE_SHELF_CPU_LIMIT=2.0
KINDLE_SHELF_PIDS_LIMIT=256

# Leave empty to generate and persist a random secret in data/.session-secret.
KINDLE_SHELF_SECRET=

# Optional extra hostnames, comma-separated, if not covered by PUBLIC_URL.
KINDLE_SHELF_TRUSTED_HOSTS=
